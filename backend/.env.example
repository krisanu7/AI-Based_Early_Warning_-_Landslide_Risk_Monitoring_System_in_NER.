# ==============================================================================
# SAFE-SLOPE NER (Landslide Risk Early Warning System) - Backend Environment Configuration
# ==============================================================================
# Instructions: Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit your actual '.env' file with real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Settings
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-address>/?appName=<AppName>
# Or local instance: mongodb://localhost:27017
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Landslide
DATABASE_NAME=ner_landslide_db

# ------------------------------------------------------------------------------
# 2. PostgreSQL + PostGIS (Hybrid Spatial Database - Optional)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (e.g., from Neon, Supabase, Render, or local PostGIS)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/swasthya_jal_postgis

# Option B: Individual connection parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=swasthya_jal_postgis

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security
# ------------------------------------------------------------------------------
# Generate a secure 64-character random string for production (e.g., openssl rand -hex 32)
SECRET_KEY=generate-a-secure-random-secret-key-here

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Visual Damage Inspector & RAG Advisor)
# ------------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Real Email OTP Verification (SMTP - e.g., Gmail / Brevo / SendGrid)
# ------------------------------------------------------------------------------
# For Gmail: Use a 16-character App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 6. Google Sign-In / OAuth (Google Identity Services)
# ------------------------------------------------------------------------------
# Create a Web Client ID at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

